# Copy to .env.backup.local (Git excluded). Never put actual values in this template.
SONGFOOD_DATABASE_URL=
SONGFOOD_RESTORE_DATABASE_URL=
# Generate locally: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
# Keep a protected copy of this key separate from the archive. No chat/Git storage.
BACKUP_ENCRYPTION_KEY=
SONGFOOD_BACKUP_DIR=.npm-cache/backups
# Paths are optional if PostgreSQL tools are on PATH.
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
PSQL_BIN=psql
