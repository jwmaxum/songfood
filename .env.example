# ==============================================================================
# Anatolia Web App - Supabase & Environment Configuration Example (.env.example)
# ==============================================================================

# Public Supabase Connection URL
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Public Supabase Anonymous Key (Client-side Queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Private Supabase Service Role Key (Server-side Admin Mutations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Public Application Origin URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare account-scoped API token with Workers Scripts write permission
Account_ID=your-cloudflare-account-id
API_Key=your-cloudflare-account-api-token

# Optional payment server key. Without it, payment confirmation returns 503.
TOSS_SECRET_KEY=
